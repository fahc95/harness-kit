// db-backup credential helpers (.agents/skills/db-backup/SKILL.md). The only code that ever
// holds the production URL. db-backup.mjs reads the env file through loadCreds and writes a
// mode-600 pgpass and service file that the client containers mount read-only, so the URL
// never passes through a shell, argv, a log or an agent's context.
// Rule: no message or exception text ever interpolates a URL, host, user, dbname or password.
import fs from "node:fs";
import path from "node:path";
import { parseEnv } from "node:util";

export const SERVICE = "backup-source";
const SSL_MODES = new Set(["disable", "allow", "prefer", "require", "verify-ca", "verify-full"]);
const LOCAL_HOSTS = new Set(["localhost", "127.0.0.1", "::1", "[::1]", "host.docker.internal"]);
const NAME_RE = /^[A-Za-z0-9_.-]+$/;
const HOST_RE = /^[A-Za-z0-9.-]+$/;
const DEFAULT_PORT = 5432;
// The dump crosses the public internet: TLS or fail. Opt out only explicitly with ?sslmode=prefer.
const DEFAULT_SSLMODE = "require";
const INVALID = "the production URL is not a valid postgres URL";

/** The first variable in `names` that the env file sets, with its value. */
export function pickUrl(env, names) {
  for (const name of names) {
    if (typeof env[name] === "string" && env[name].trim() !== "") return { name, url: env[name].trim() };
  }
  throw new Error(`none of ${names.join(", ")} is set in the env file`);
}

/** The URL's parts, checked. Errors never quote the URL or any part of it. */
export function parseDbUrl(url) {
  let u;
  let parts;
  try {
    u = new URL(url);
    parts = {
      host: u.hostname,
      port: u.port === "" ? DEFAULT_PORT : Number(u.port),
      dbname: decodeURIComponent(u.pathname.replace(/^\//, "")),
      user: decodeURIComponent(u.username),
      password: decodeURIComponent(u.password),
      sslmode: u.searchParams.get("sslmode") ?? DEFAULT_SSLMODE,
    };
  } catch {
    throw new Error(INVALID);
  }
  if (u.protocol !== "postgres:" && u.protocol !== "postgresql:") throw new Error(`${INVALID} (protocol)`);
  if (!HOST_RE.test(parts.host)) throw new Error(`${INVALID} (host)`);
  if (LOCAL_HOSTS.has(parts.host)) throw new Error("the production URL points at a local host, not production");
  if (!Number.isInteger(parts.port) || parts.port < 1 || parts.port > 65535) throw new Error(`${INVALID} (port)`);
  if (!NAME_RE.test(parts.dbname)) throw new Error(`${INVALID} (database name)`);
  if (!NAME_RE.test(parts.user)) throw new Error(`${INVALID} (user)`);
  if (parts.password === "" || /[\r\n]/.test(parts.password)) throw new Error(`${INVALID} (password)`);
  if (!SSL_MODES.has(parts.sslmode)) throw new Error(`${INVALID} (sslmode)`);
  return parts;
}

const escapePgpass = (s) => String(s).replaceAll("\\", "\\\\").replaceAll(":", "\\:");

export const pgpassLine = (c) => `${[c.host, c.port, c.dbname, c.user, c.password].map(escapePgpass).join(":")}\n`;

// No password here: libpq takes it from the pgpass file.
export const serviceFile = (c, service = SERVICE) =>
  `[${service}]\nhost=${c.host}\nport=${c.port}\ndbname=${c.dbname}\nuser=${c.user}\nsslmode=${c.sslmode}\n`;

const escapeRegExp = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

/** Text with every credential, any postgres URL and any IP address removed. */
export function redact(text, c, url) {
  const secrets = [url, c?.password, c?.password && encodeURIComponent(c.password), c?.host, c?.user, c?.dbname]
    .filter((s) => typeof s === "string" && s !== "")
    .sort((a, b) => b.length - a.length);
  // Any postgres URL first, so a variant of the stored URL can't survive the literal pass.
  let out = text.replace(/postgres(?:ql)?:\/\/\S+/g, "<redacted-url>");
  for (const s of secrets) out = out.replace(new RegExp(escapeRegExp(s), "g"), "<redacted>");
  // libpq prints the resolved address next to the host: strip IPv4 and IPv6 literals.
  return out
    .replace(/\b(?:\d{1,3}\.){3}\d{1,3}\b/g, "<ip>")
    .replace(/(?<![0-9a-z:])(?:[0-9a-f]{0,4}:){2,7}(?:[0-9a-f]{1,4}|:)(?![0-9a-z:])/gi, "<ip>"); // Also hits hh:mm:ss; over-redacting is fine.
}

/** Read the env file and return the variable used and the parsed credentials. */
export function loadCreds(envFile, names) {
  const env = parseEnv(fs.readFileSync(envFile, "utf8"));
  const { name, url } = pickUrl(env, names);
  return { name, url, creds: parseDbUrl(url) };
}

/** Write pgpass and pg_service.conf into a new mode-700 folder. Throws if it exists. */
export function writeCredFiles(dir, creds, service = SERVICE) {
  fs.mkdirSync(dir, { mode: 0o700 });
  fs.writeFileSync(path.join(dir, "pgpass"), pgpassLine(creds), { mode: 0o600, flag: "wx" });
  fs.writeFileSync(path.join(dir, "pg_service.conf"), serviceFile(creds, service), { mode: 0o600, flag: "wx" });
}
