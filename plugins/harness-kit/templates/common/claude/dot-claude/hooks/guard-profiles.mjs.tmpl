// Bash allowlists for bash-guard.mjs, one profile per scoped persona. Generated by harness-kit
// from this repo's own commands, then owned by the project: edit it here to widen or narrow a
// profile, and add a case to guards.test.mjs for every new entry.
// Commands are matched exactly (no extra arguments), and none may reach production.

// The same rule harness-kit applied when it wrote these lists: one command line with no shell
// metacharacters, so an entry can't smuggle in a pipe, a redirect or a second command.
const COMMAND_RE = /^[A-Za-z0-9_@./:=+-]+( [A-Za-z0-9_@./:=+-]+)*$/;

export const escapeRegExp = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

// Throws on a bad entry. bash-guard imports this file after its crash handlers, so a throw
// here blocks every call (fail closed) instead of allowing a malformed command.
export const exact = (commands) =>
  commands.map((c) => {
    if (typeof c !== "string" || !COMMAND_RE.test(c)) throw new Error(`bad command in guard-profiles.mjs: ${JSON.stringify(c)}`);
    return new RegExp(`^${escapeRegExp(c)}$`);
  });

// The check commands (typecheck, lint, test).
export const VERIFY_COMMANDS = {{VERIFY_COMMANDS_JSON}};

// kit:if has.db
// Local-database commands only (generate, create a migration without applying it, apply to the
// local database, seed). Never a command that reaches a deployed database.
export const DB_COMMANDS = {{DB_COMMANDS_JSON}};
// kit:end
// kit:if !has.db
export const DB_COMMANDS = [];
// kit:end

// Git subcommands get any arguments, but bash-guard's FORBIDDEN rejects `--ou…` (git accepts
// abbreviations of `--output`, which writes a file).
const GIT_INSPECT = [
  /^git (status|diff|log|show|ls-files|merge-base|rev-parse)( [\w@^~.:/=,+-]+)*$/,
  /^git branch --show-current$/,
];
const GIT_SUMMARY = "git inspection (status, diff, log, show, ls-files, merge-base, rev-parse, branch --show-current)";
const list = (commands) => (commands.length ? commands.join(", ") : "none");

export const PROFILES = {
  "read-only": {
    summary: `${GIT_SUMMARY} and the check commands: ${list(VERIFY_COMMANDS)}`,
    allowed: [...GIT_INSPECT, ...exact(VERIFY_COMMANDS)],
  },
  architect: {
    summary: `${GIT_SUMMARY}, the check commands: ${list(VERIFY_COMMANDS)}, and the local database commands: ${list(DB_COMMANDS)}`,
    allowed: [...GIT_INSPECT, ...exact(VERIFY_COMMANDS), ...exact(DB_COMMANDS)],
  },
};
