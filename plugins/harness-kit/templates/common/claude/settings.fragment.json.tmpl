{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(//**/.env)",
      "Read(**/.env.local)",
      "Read(//**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(//**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(//**/.env.development)",
      "Read(**/.env.dev)",
      "Read(//**/.env.dev)",
      "Read(**/.env.production)",
      "Read(//**/.env.production)",
      "Read(**/.env.prod)",
      "Read(//**/.env.prod)",
      "Read(**/.env.staging)",
      "Read(//**/.env.staging)",
      "Read(**/.env.test)",
      "Read(//**/.env.test)",
      "Read(**/.env.bak)",
      "Read(//**/.env.bak)",
      "Read(**/.env.backup)",
      "Read(//**/.env.backup)",
      "Edit(**/.env)",
      "Edit(//**/.env)",
      "Edit(**/.env.local)",
      "Edit(//**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(//**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(//**/.env.development)",
      "Edit(**/.env.dev)",
      "Edit(//**/.env.dev)",
      "Edit(**/.env.production)",
      "Edit(//**/.env.production)",
      "Edit(**/.env.prod)",
      "Edit(//**/.env.prod)",
      "Edit(**/.env.staging)",
      "Edit(//**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(//**/.env.test)",
      "Edit(**/.env.bak)",
      "Edit(//**/.env.bak)",
      "Edit(**/.env.backup)",
      "Edit(//**/.env.backup)"
    ],
    "allow": {{ALLOW_RULES_JSON}}
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'End of session: consider /retro to log lessons.'"
          }
        ]
      }
    ]
  }
}
