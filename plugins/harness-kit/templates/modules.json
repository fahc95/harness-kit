          "onExisting": "kit-new"
        },
        {
          "template": "core/dot-agents/personas/retro.md.tmpl",
          "target": ".agents/personas/retro.md",
          "onExisting": "kit-new"
        },
        {
          "template": "core/dot-agents/personas/reviewer.md.tmpl",
          "target": ".agents/personas/reviewer.md",
          "onExisting": "kit-new",
          "adapt": true
        },
        {
          "template": "core/dot-agents/rules/commands.md.tmpl",
