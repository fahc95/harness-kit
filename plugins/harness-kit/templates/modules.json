{
  "schemaVersion": 1,
  "description": "Module registry. Each module lists its template files and the target path each renders to. The installer offers common modules by their offer text, skips those whose when flag is false, and records what it installed in .agents/harness.json. See docs/templates.md in the kit repo.",
  "modules": [
    {
      "id": "core",
      "tier": "core",
      "title": "Core harness",
      "offer": "AGENTS.md, the architect, planner, reviewer, retro and researcher personas, the plan, review, feature and retro skills (.agents/skills/), cross-cutting rules (.agents/rules/) and memory seeds (.agents/memory/).",
      "default": true,
      "requires": [],
      "when": null,
      "files": [
        {
          "template": "core/AGENTS.md.tmpl",
          "target": "AGENTS.md",
          "onExisting": "merge",
          "adapt": true
        },
        {
          "template": "core/docs/next-steps.md.tmpl",
