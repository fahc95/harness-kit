    {
      "id": "open-pr",
      "tier": "common",
      "flag": "module.openPr",
      "title": "open-pr skill",
      "offer": "A skill that opens PRs the way this repo expects: checks review and tests passed, the branch name, a Conventional Commit title and a templated body with rollback notes, then runs gh pr create. Also installs .github/pull_request_template.md.",
      "default": true,
      "requires": [
        "core"
      ],
      "when": "has.github",
      "files": [
        {
          "template": "common/open-pr/dot-agents/skills/open-pr/SKILL.md.tmpl",
          "target": ".agents/skills/open-pr/SKILL.md",
          "onExisting": "kit-new"
        },
        {
          "template": "common/open-pr/dot-agents/skills/open-pr/scripts/check-pr.mjs.tmpl",
          "target": ".agents/skills/open-pr/scripts/check-pr.mjs",
          "onExisting": "kit-new"
        },
        {
          "template": "common/open-pr/dot-agents/skills/open-pr/scripts/check-pr.test.mjs.tmpl",
          "target": ".agents/skills/open-pr/scripts/check-pr.test.mjs",
          "onExisting": "kit-new"
        },
        {
          "template": "common/open-pr/dot-claude/skills/open-pr/SKILL.md.tmpl",
          "target": ".claude/skills/open-pr/SKILL.md",
          "when": "module.claude",
          "onExisting": "kit-new"
        },
        {
          "template": "common/open-pr/dot-github/pull_request_template.md.tmpl",
          "target": ".github/pull_request_template.md",
          "onExisting": "merge"
        }
      ],
      "settings": [],
      "postInstall": []
    },
    {
      "id": "githooks-pre-push",
      "tier": "common",
      "flag": "module.prePush",
      "title": "pre-push guard",
      "offer": "A checked-in git hook that refuses pushes to main, with an owner-only override. Armed once per clone with git config core.hooksPath .githooks.",
      "default": true,
      "requires": [
        "core"
      ],
      "when": null,
      "files": [
        {
          "template": "common/githooks-pre-push/dot-githooks/pre-push.test.mjs.tmpl",
          "target": ".githooks/pre-push.test.mjs",
          "onExisting": "kit-new"
        },
        {
          "template": "common/githooks-pre-push/dot-githooks/pre-push.tmpl",
          "target": ".githooks/pre-push",
          "mode": "0755",
          "onExisting": "kit-new"
        }
      ],
      "settings": [],
      "postInstall": [
        "git config core.hooksPath .githooks"
      ]
    },
    {
      "id": "pm",
      "tier": "common",
      "flag": "module.pm",
      "title": "PM persona",
      "offer": "A product manager persona and /pm skill that own what gets built and in what order: rank what to work on next, triage ideas and bugs, shape features before the planner, and sync the backlog after each retro. The backlog lives in a PM tool reached through its MCP server (Linear by default; Notion, Jira, GitHub Issues and others work too), or, with no tool, in docs/backlog.md.",
      "default": true,
      "requires": [
        "core"
      ],
      "when": null,
      "files": [
        {
          "template": "common/pm/dot-agents/personas/pm.md.tmpl",
          "target": ".agents/personas/pm.md",
          "onExisting": "kit-new",
          "adapt": true
        },
