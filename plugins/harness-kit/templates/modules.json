    {
      "id": "antigravity",
      "tier": "common",
      "flag": "module.antigravity",
      "title": "Antigravity adapter",
      "offer": "GEMINI.md with Antigravity sub-agent wiring (define_subagent and invoke_subagent for each persona) and .agents/hooks.json with .agents/hooks/agy-guard.mjs (PreToolUse guard blocking .env access, main pushes, --no-verify and gating production commands) plus regression tests.",
      "default": true,
      "requires": [
        "core"
      ],
      "when": null,
      "files": [
        {
          "template": "common/antigravity/GEMINI.md.tmpl",
          "target": "GEMINI.md",
          "onExisting": "merge"
        },
        {
          "template": "common/antigravity/dot-agents/hooks.json.tmpl",
          "target": ".agents/hooks.json",
          "onExisting": "kit-new"
        },
        {
          "template": "common/antigravity/dot-agents/hooks/agy-guard.mjs.tmpl",
          "target": ".agents/hooks/agy-guard.mjs",
          "onExisting": "kit-new"
        },
        {
          "template": "common/antigravity/dot-agents/hooks/agy-guard.test.mjs.tmpl",
          "target": ".agents/hooks/agy-guard.test.mjs",
          "onExisting": "kit-new"
        }
