    {
      "id": "flow-migration",
      "tier": "common",
      "title": "Git Flow to GitHub Flow migration",
      "offer": "This repo uses Git Flow. Move it to GitHub Flow: the install PR narrows CI triggers to main, removes release and back-sync workflows you approve, keeps docs-only changes from deploying, and adds a runbook of the GitHub settings you change by hand.",
      "default": true,
      "requires": [
        "core",
        "open-pr"
      ],
      "when": "flow.gitFlow",
      "files": [
        {
          "template": "common/flow-migration/docs/plans/{{DATE_YM}}-github-flow-migration.md.tmpl",
          "target": "docs/plans/{{DATE_YM}}-github-flow-migration.md",
          "onExisting": "kit-new",
          "adapt": true
