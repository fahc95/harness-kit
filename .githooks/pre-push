#!/bin/sh
# Refuse pushes that update or delete main (AGENTS.md "Git and PRs").
# Every change reaches main through a PR. A deliberate promotion, by Freddy only:
#   HARNESS_KIT_ALLOW_PUSH_MAIN=1 git push ...
# Enable once per clone: git config core.hooksPath .githooks
protected="refs/heads/main"
status=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "$protected" ] || continue
  if [ "${HARNESS_KIT_ALLOW_PUSH_MAIN:-}" = "1" ]; then
    echo "pre-push: HARNESS_KIT_ALLOW_PUSH_MAIN=1, allowing the push to main." >&2
  else
    echo "pre-push: refusing to push to main. Open a PR instead (AGENTS.md \"Git and PRs\")." >&2
    echo "pre-push: a deliberate promotion overrides with HARNESS_KIT_ALLOW_PUSH_MAIN=1." >&2
    status=1
  fi
done
exit "$status"
